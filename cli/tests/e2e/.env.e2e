# E2E env — own copy, independent from the root .env (gitignored).
# Seeded from the root .env on 2026-06-12; adjust freely for e2e runs.

SPTOOL_PATH=/home/rafal/Projects/curio/sptool
E2E_HTTP_PORT=18080
E2E_TIMEOUT_SECONDS=180
E2E_POLL_INTERVAL_SECONDS=3
E2E_ECHO_CLI=true

DEBUG=false

# Needed for sp onboard-data command, path for aria2c binary, leave empty to use PATH lookup
ARIA2C_PATH=

# Needed for sp claim-allocations curio command, path for curio binary, leave empty to use PATH lookup
CURIO_PATH=

# Needed for sp claim-allocations boost command, path for boostd binary, leave empty to use PATH lookup
BOOSTD_PATH=

# Enables dry-run mode, which only simulates transactions without broadcasting them to the network
DRY_RUN=false

# SPRegistry database connection string used for admin operations
SP_REGISTRY_DATABASE_URL=

# Network RPC URL
# https://chainlist.org/chain/314 for mainnet
RPC_URL=http://127.0.0.1:1234/rpc/v1
PRIVATE_KEY_TEST=0x6dfde77e1defbe9edf9efbdf8e37e7ce7cefce39e3de9ce1ce3ce3dddddb6edd
PRIVATE_KEY_SP=0xfc734ea1d1670fca55b3d3fc1c2a9e18b9c298b41e61c38786f89201772eac1e

# POREP_MARKET_REPO=https://github.com/fidlabs/porep-market.git
# POREP_MARKET_BRANCH=main

POREP_MARKET=0x3CA395fcA2FDfd8E8861a14Af151bf6c72D18bc4
CLIENT_CONTRACT=0xDd14e0A3256e64Ffb73fddf1bdc59d65d849d49b
SP_REGISTRY=0xFE82517905251179E1a19c90adbeb2B70328F6b0
VALIDATOR_FACTORY=0xfc2574E581119Ff413199df2841d79299E3E147D
SLI_ORACLE=0xF6042FDd1d07e52F94964dAF24d2DcFBCa9aE603
SLI_SCORER=0xa1a14A3E1Ebf2ba05e4e8D2f5EF804459cfDaFbC
META_ALLOCATOR=0x3A3250fEb9A9b60eE7d3a81a5E06026aDe2206Ba
ALLOCATOR_FACTORY=0x9713E722740D0e74177B6b6CCc13B85BC6f5C649
FILECOIN_PAY=0x806cDF237C068580070D85F9973CD08393beDB59
USDC_TOKEN=0x7365b0bBa62D733FDB3Ca926874a91f5E2c52F6d

# Private key used in admin operations
# Set this if you want to perform admin-only operations
# 32-byte raw private key (hex, 0x-prefixed)
ADMIN_PRIVATE_KEY=0x6dfde77e1defbe9edf9efbdf8e37e7ce7cefce39e3de9ce1ce3ce3dddddb6edd

# Private key used in SP operations
# Set this if you want to interact with the system as a storage provider (organization)
# This address needs to be the controlling address of provider_id you want to manage in the SPRegistry contract
# See https://lotus.filecoin.io/storage-providers/operate/addresses/#control-addresses
# 32-byte raw private key (hex, 0x-prefixed)
SP_PRIVATE_KEY=0x6dfde77e1defbe9edf9efbdf8e37e7ce7cefce39e3de9ce1ce3ce3dddddb6edd

# Organization address to manage SPs from
# You must have the SP_PRIVATE_KEY of an organization controlling address set to perform SP management operations
SP_ORGANIZATION=0x6dfde77e1defbe9edf9efbdf8e37e7ce7cefce39e3de9ce1ce3ce3dddddb6edd

# --- Lotus wallet signing (alternative to SP_PRIVATE_KEY) ---
# Set SP_LOTUS_WALLET + LOTUS_TOKEN to sign via a Lotus-backed RPC.
# The private key never leaves Lotus — only raw transaction bytes are sent for signing.
# SP_PRIVATE_KEY must be empty when using Lotus wallet signing.

# Lotus wallet address (f410/t410) — must be a delegated address, not BLS (f3/t3)
# SP_SIGN_METHOD='lotus-wallet'
# SP_LOTUS_WALLET='t410f5p6mu4jorv3ooscctbelhuhujqnkpriwyhjkc2q'

# ADMIN_LOTUS_WALLET=t410f5p6mu4jorv3ooscctbelhuhujqnkpriwyhjkc2q
# ADMIN_SIGN_METHOD=lotus-wallet
# Lotus wallet address (f410/t410) — must be a delegated address, not BLS (f3/t3)
# Private key used in client operations
# Set this if you want to interact with the system as a client
# This is the address that will be charged for deal payments
# 32-byte raw private key (hex, 0x-prefixed)
CLIENT_PRIVATE_KEY=0x6dfde77e1defbe9edf9efbdf8e37e7ce7cefce39e3de9ce1ce3ce3dddddb6edd

# Client address to use in client read-only operations
# Must match the address derived from CLIENT_PRIVATE_KEY for blockchain transactions
# CLIENT_ADDRESS=0xfe7be36ef6e77eb9e9be5ae9ee37efce3ae9be9def4eb9e77ebce7dddddb6edd
# CLIENT_SIGN_METHOD='lotus-wallet'
# CLIENT_LOTUS_WALLET='t410f5p6mu4jorv3ooscctbelhuhujqnkpriwyhjkc2q'

# Lotus token — only 'sign' permission required (lotus auth create-token --perm sign)
LOTUS_TOKEN='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJBbGxvdyI6WyJyZWFkIiwid3JpdGUiLCJzaWduIl19.YvkZdYwEhGBrA-3G6A3Qd0OlL5ylCIRJ9_-I4NwS3lM'
